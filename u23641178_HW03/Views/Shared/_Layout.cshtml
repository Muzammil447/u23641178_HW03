<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - BikeStores</title>

    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --navy: #001f3f;
            --dark-navy: #001530;
            --orange: #ff7f50;
            --cream: #f9f7f4;
        }

        body {
            background-color: var(--cream);
            font-family: "Poppins", sans-serif;
            margin: 0;
            padding: 0;
        }

        /* ===== NAVBAR ===== */
        .navbar-custom {
            background-color: var(--navy);
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
            padding: 0.75rem 1.5rem;
        }

        .navbar-brand {
            color: var(--orange) !important;
            font-weight: 700;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .navbar-brand i {
                font-size: 1.8rem;
            }

        .navbar-nav .nav-link {
            color: #e0e0e0 !important;
            font-weight: 500;
            margin: 0 8px;
            border-radius: 6px;
            transition: all 0.3s ease;
            padding: 8px 14px;
        }

            .navbar-nav .nav-link:hover,
            .navbar-nav .nav-link.active {
                color: var(--orange) !important;
                background-color: rgba(255, 255, 255, 0.1);
                transform: translateY(-2px);
            }

        .navbar-toggler {
            border-color: rgba(255, 255, 255, 0.4);
        }

        /* ===== CONTENT WRAPPER ===== */
        .content-wrapper {
            margin-top: 90px;
            padding: 25px;
        }

        /* ===== FOOTER ===== */
        footer {
            background-color: var(--dark-navy);
            color: #e0e0e0;
            text-align: center;
            padding: 18px 0;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            margin-top: 60px;
        }

            footer i {
                color: var(--orange);
            }

        /* ===== PAGINATION ===== */
        .pagination {
            justify-content: center;
            margin: 20px 0;
        }

            .pagination li a, .pagination li span {
                border-radius: 6px;
                margin: 0 2px;
                color: var(--navy);
                border: 1px solid #d6d6d6;
                background-color: #fff;
                transition: all 0.2s;
            }

                .pagination li a:hover {
                    background-color: var(--orange);
                    color: #fff;
                }

            .pagination li.active span {
                background-color: var(--orange);
                border-color: var(--orange);
                color: #fff;
            }
    </style>
</head>
<body>
    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <a class="navbar-brand" href="@Url.Action("Index", "Home")">
            BikeStores
        </a>

        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarMenu">
            <span class="navbar-toggler-icon" style="filter: invert(100%);"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="navbarMenu">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "active" : "")"
                       href="@Url.Action("Index", "Home")">
                        <i class="fas fa-home"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Maintain" ? "active" : "")"
                       href="@Url.Action("Index", "Maintain")">
                        <i class="fas fa-"></i> Maintain
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Report" ? "active" : "")"
                       href="@Url.Action("Index", "Report")">
                        <i class="fas fa-chart-bar"></i> Reports
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- ===== MAIN CONTENT ===== -->
    <div class="container-fluid content-wrapper">
        @RenderBody()
    </div>

    <!-- ===== FOOTER ===== -->
    <footer>
        <p>
            &copy; @DateTime.Now.Year - <i class="fas fa-bicycle"></i> BikeStores | Designed by Muzammil
        </p>
    </footer>

    <!-- ===== SCRIPTS ===== -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)

</body>
</html>
<script>
    // Save scroll position before leaving page
    $(window).on("beforeunload", function () {
        localStorage.setItem("scrollTop", $(window).scrollTop());
    });

    // Restore scroll position on page load
    $(document).ready(function () {
        var scrollTop = localStorage.getItem("scrollTop");
        if (scrollTop !== null) {
            $(window).scrollTop(scrollTop);
            localStorage.removeItem("scrollTop");
        }
    });
</script>